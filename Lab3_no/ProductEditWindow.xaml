<Window x:Class="Lab3_no.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab3_no"
        mc:Ignorable="d"
        Title="ProductEditWindow" Height="450" Width="800">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                   Text="Добавление / Редактирование товара" 
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="ID:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <TextBox x:Name="IdTextBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Background="LightGray" Visibility="Collapsed" Margin="0,0,0,5"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Наименование:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <ComboBox x:Name="NameComboBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,5" DisplayMemberPath="Name" SelectedValuePath="Id"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Категория:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <ComboBox x:Name="CategoryComboBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,5" DisplayMemberPath="Name" SelectedValuePath="Id"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Производитель:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <ComboBox x:Name="ManufacturerComboBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,5" DisplayMemberPath="Name" SelectedValuePath="Id"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Поставщик:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <ComboBox x:Name="SupplierComboBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,5" DisplayMemberPath="Name" SelectedValuePath="Id"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Описание:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <TextBox x:Name="DescriptionTextBox" Grid.Row="6" Grid.Column="1" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,5"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Цена (₽):" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <TextBox x:Name="PriceTextBox" Grid.Row="7" Grid.Column="1" Margin="0,0,0,5"/>

        <TextBlock Grid.Row="8" Grid.Column="0" Text="Количество:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <TextBox x:Name="CountTextBox" Grid.Row="8" Grid.Column="1" Margin="0,0,0,5"/>

        <TextBlock Grid.Row="9" Grid.Column="0" Text="Скидка (%):" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <TextBox x:Name="DiscountTextBox" Grid.Row="9" Grid.Column="1" Margin="0,0,0,5"/>

        <StackPanel Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Сохранить" Width="100" Height="35" Margin="0,0,10,0" Click="SaveButton_Click"/>
            <Button Content="Отмена" Width="100" Height="35" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
